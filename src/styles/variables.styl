/* ===== 基础变量定义 ===== */
:root
  --radius-large: 0.25rem
  --content-delay: 150ms

/* ===== 构成主义色票（固定色板，不随 --hue 变化） ===== */
:root
  /* 保底色相：让残留的 var(--hue) 引用落在金色附近，而不是主题蓝 */
  --hue: 42

  /* 构成主义基础色票 */
  --ink: #101218
  --ink-deep: #0B0D12
  --ink-soft: #171922
  --cream: #F1E9D6
  --cream-soft: #EAE0C8
  --gold: #C8A45D
  --gold-deep: #B08D3F
  --vermilion: #B3392C

/* ===== 主题相关变量 —— 亮色：奶油纸面 + 墨色图形 ===== */
:root
  --primary: #9C7A2E
  --page-bg: #F1E9D6
  --card-bg: #FAF4E3
  --card-bg-transparent: unquote("rgb(250 244 227 / var(--card-transparent-opacity, 0.6))")

  --btn-content: #7A5F22
  --btn-regular-bg: #EAE0C6
  --btn-regular-bg-hover: #E0D3B1
  --btn-regular-bg-active: #D4C49C

  --btn-plain-bg-hover: rgba(23, 24, 30, 0.07)
  --btn-plain-bg-active: rgba(23, 24, 30, 0.11)

  --btn-card-bg-hover: #EFE5CC
  --btn-card-bg-active: #E4D7B6

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #22242C
  --title-active: #8C6B26

  --line-divider: rgba(30, 29, 22, 0.16)
  --line-color: rgba(30, 29, 22, 0.2)
  --meta-divider: rgba(30, 29, 22, 0.32)
  --content-meta: rgba(30, 29, 22, 0.62)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: #8A3A2E
  --selection-bg: rgba(200, 164, 93, 0.4)
  --codeblock-bg: #14161D
  --codeblock-topbar-bg: #1F222C

  --license-block-bg: rgba(30, 29, 22, 0.05)

  --link-underline: rgba(176, 141, 63, 0.5)
  --link-hover: #B08D3F
  --link-active: #8C6B26

  --float-panel-bg: #FAF4E3

  --scrollbar-bg-light: rgba(30, 29, 22, 0.35)
  --scrollbar-bg-hover-light: rgba(30, 29, 22, 0.45)
  --scrollbar-bg-active-light: rgba(30, 29, 22, 0.55)

  --scrollbar-bg-dark: rgba(241, 233, 214, 0.3)
  --scrollbar-bg-hover-dark: rgba(241, 233, 214, 0.4)
  --scrollbar-bg-active-dark: rgba(200, 164, 93, 0.55)

  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)

  --display-light-icon: 1
  --display-dark-icon: 0

  --admonitions-color-tip: #2F7D6B
  --admonitions-color-note: #4A63B8
  --admonitions-color-important: #9C7A2E
  --admonitions-color-warning: #B08D3F
  --admonitions-color-caution: #B3392C

  /* TOC相关变量 */
  --toc-badge-bg: #EAE0C6
  --toc-btn-hover: #E4D9BC
  --toc-btn-active: #DACDA9
  --toc-indicator-bg: #E6DCC0
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #9C7A2E

  /* 主题色选择条渐变（保留给显示设置面板，已不再驱动全站配色） */
  --color-selection-bar: linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))

/* 卡片风格跟随主题色相 —— 固定为奶油暖白 */
:root:not(.dark) body.card-follow-theme-hue
  --card-bg: #FBF6E8

/* ===== 主题相关变量 —— 暗色：墨黑底 + 米白文字 + 金线 + 朱红 ===== */
:root.dark
  --primary: #C8A45D
  --page-bg: #0C0E13
  --card-bg: #16181F
  --card-bg-transparent: unquote("rgb(22 24 31 / var(--card-transparent-opacity, 0.6))")

  --inline-code-color: #E08A7A

  --btn-content: #C8A45D
  --btn-regular-bg: #23252F
  --btn-regular-bg-hover: #2B2D39
  --btn-regular-bg-active: #333642

  --btn-plain-bg-hover: rgba(241, 233, 214, 0.07)
  --btn-plain-bg-active: rgba(241, 233, 214, 0.11)

  --btn-card-bg-hover: #1D1F28
  --btn-card-bg-active: #24262F

  --line-divider: rgba(200, 164, 93, 0.18)
  --line-color: rgba(200, 164, 93, 0.24)
  --meta-divider: rgba(241, 233, 214, 0.28)
  --content-meta: rgba(241, 233, 214, 0.55)

  --selection-bg: rgba(200, 164, 93, 0.35)
  --codeblock-bg: #0F1117
  --codeblock-topbar-bg: #1A1C24

  --license-block-bg: var(--codeblock-bg)

  --link-underline: rgba(200, 164, 93, 0.45)
  --link-hover: #C8A45D
  --link-active: #B08D3F

  --float-panel-bg: #16181F

  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)

  --display-light-icon: 0
  --display-dark-icon: 1

  --admonitions-color-tip: #4BA68F
  --admonitions-color-note: #7C93D4
  --admonitions-color-important: #C8A45D
  --admonitions-color-warning: #C8A45D
  --admonitions-color-caution: #C9503F

  /* TOC相关变量 - 暗色主题 */
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: #22242E
  --toc-btn-active: #282A35
  --toc-indicator-bg: #22242E
  --toc-item-active: #C8A45D

  /* 主题色选择条渐变 - 暗色主题 */
  --color-selection-bar: linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

/* ===== 响应式断点变量 ===== */
:root
  /* 断点定义 */
  --breakpoint-xs: 320px
  --breakpoint-sm: 480px
  --breakpoint-md: 768px
  --breakpoint-lg: 1024px
  --breakpoint-xl: 1280px
  --breakpoint-2xl: 1536px
  
  /* 容器宽度 */
  --container-xs: 100%
  --container-sm: 100%
  --container-md: 100%
  --container-lg: 1024px
  --container-xl: 1280px
  --container-2xl: 1536px

/* ===== 动画变量 ===== */
:root
  /* 缓动函数 */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1)
  --ease-decelerate: cubic-bezier(0.25, 0.46, 0.45, 0.94)
  --ease-accelerate: cubic-bezier(0.55, 0.055, 0.675, 0.19)
  --ease-sharp: cubic-bezier(0.4, 0, 0.6, 1)
  
  /* 动画时长 */
  --duration-fast: 100ms
  --duration-normal: 150ms
  --duration-medium: 200ms
  --duration-slow: 250ms
  --duration-slower: 300ms
  
  /* 动画延迟 */
  --delay-none: 0ms
  --delay-short: 30ms
  --delay-medium: 60ms
  --delay-long: 90ms
  --delay-longer: 120ms

/* ===== 间距变量 ===== */
:root
  /* 基础间距 */
  --spacing-xs: 0.25rem    /* 4px */
  --spacing-sm: 0.5rem     /* 8px */
  --spacing-md: 0.75rem    /* 12px */
  --spacing-lg: 1rem       /* 16px */
  --spacing-xl: 1.25rem    /* 20px */
  --spacing-2xl: 1.5rem    /* 24px */
  --spacing-3xl: 2rem      /* 32px */
  --spacing-4xl: 2.5rem    /* 40px */
  --spacing-5xl: 3rem      /* 48px */
  
  /* 组件间距 */
  --widget-gap-mobile: var(--spacing-md)
  --widget-gap-tablet: var(--spacing-lg)
  --widget-gap-desktop: var(--spacing-xl)
  
  /* 侧边栏宽度 */
  --sidebar-width-mobile: 100%
  --sidebar-width-tablet: 280px
  --sidebar-width-desktop: 320px

/* ===== 阴影变量 ===== */
:root
  /* 基础阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05)
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1)
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1)
  --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.1)
  --shadow-2xl: 0 25px 50px rgba(0, 0, 0, 0.25)
  
  /* 特殊阴影 */
  --shadow-navbar: 0 6px 20px -6px rgba(30, 29, 22, 0.18)
  --shadow-navbar-dark: 0 6px 20px -6px rgba(0, 0, 0, 0.5)
  --shadow-button: 0 2px 8px rgba(30, 29, 22, 0.12)
  --shadow-button-dark: 0 2px 8px rgba(0, 0, 0, 0.4)

/* ===== 边框半径变量 ===== */
:root
  --radius-sm: 0.25rem     /* 4px */
  --radius-md: 0.375rem    /* 6px */
  --radius-lg: 0.5rem      /* 8px */
  --radius-xl: 0.75rem     /* 12px */
  --radius-2xl: 1rem       /* 16px */
  --radius-3xl: 1.5rem     /* 24px */
  --radius-full: 9999px

/* ===== 透明度变量 ===== */
:root
  --opacity-0: 0
  --opacity-5: 0.05
  --opacity-10: 0.1
  --opacity-20: 0.2
  --opacity-25: 0.25
  --opacity-30: 0.3
  --opacity-40: 0.4
  --opacity-50: 0.5
  --opacity-55: 0.55
  --opacity-60: 0.6
  --opacity-70: 0.7
  --opacity-75: 0.75
  --opacity-80: 0.8
  --opacity-85: 0.85
  --opacity-90: 0.9
  --opacity-95: 0.95
  --opacity-100: 1

/* ===== 模糊效果变量 ===== */
:root
  --blur-sm: 4px
  --blur-md: 8px
  --blur-lg: 12px
  --blur-xl: 16px
  --blur-2xl: 20px
  --blur-3xl: 24px

/* ===== 变换变量 ===== */
:root
  /* 平移 */
  --translate-xs: 0.125rem   /* 2px */
  --translate-sm: 0.25rem     /* 4px */
  --translate-md: 0.5rem      /* 8px */
  --translate-lg: 0.75rem     /* 12px */
  --translate-xl: 1rem        /* 16px */
  --translate-2xl: 1.5rem      /* 24px */
  --translate-3xl: 2rem       /* 32px */
  
  /* 缩放 */
  --scale-95: 0.95
  --scale-98: 0.98
  --scale-100: 1
  --scale-105: 1.05
  --scale-110: 1.1

/* ===== 层级变量 ===== */
:root
  --z-dropdown: 1000
  --z-sticky: 1020
  --z-fixed: 1030
  --z-modal-backdrop: 1040
  --z-modal: 1050
  --z-popover: 1060
  --z-tooltip: 1070
  --z-toast: 1080
  --z-navbar: 20
  --z-banner: 10
  --z-content: 30

/* ===== 性能优化变量 ===== */
:root
  /* GPU加速 */
  --gpu-transform: translateZ(0)
  --gpu-backface: hidden
  
  /* 动画性能 */
  --animation-fill-mode: both
  --animation-timing: var(--ease-standard)
  --animation-duration: var(--duration-medium)

/* ===== 响应式工具类 ===== */
@media (max-width: 767px)
  :root
    --container-width: var(--container-sm)
    --widget-gap: var(--widget-gap-mobile)
    --sidebar-width: var(--sidebar-width-mobile)

@media (min-width: 768px) and (max-width: 1279px)
  :root
    --container-width: var(--container-md)
    --widget-gap: var(--widget-gap-tablet)
    --sidebar-width: var(--sidebar-width-tablet)

@media (min-width: 1280px)
  :root
    --container-width: var(--container-lg)
    --widget-gap: var(--widget-gap-desktop)
    --sidebar-width: var(--sidebar-width-desktop)
