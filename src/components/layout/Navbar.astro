---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import { backgroundWallpaper, navBarConfig, siteConfig } from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import { LinkPresets } from "@/constants/link-presets";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";
import NavMenuPanel from "./NavMenuPanel.astro";

const className = Astro.props.class;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? backgroundWallpaper.common?.navbar?.transparentMode || "semi"
		: "semi";

// 获取导航栏毛玻璃效果配置
const navbarEnableBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.enableBlur ?? true)
		: false;

// 获取导航栏模糊度
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.blur ?? 20)
		: 0;

// 获取导航栏标题，如果没有设置则使用 siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 检查是否有任何显示设置可用
const showThemeColor = !siteConfig.themeColor.fixed;
const isWallpaperSwitchable = backgroundWallpaper.switchable ?? true;
const allowLayoutSwitch = siteConfig.postListLayout.allowSwitch;
const hasDisplaySettings =
	showThemeColor || isWallpaperSwitchable || allowLayoutSwitch;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			const preset = LinkPresets[item];
			// 主页 tab：定位到首页文章列表主体（Hero 之下的 #swup-container），
			// 平滑滚动 / 跨页导航逻辑在下方客户端脚本中处理
			if (item === LinkPreset.Home) {
				return { ...preset, url: "/#swup-container" };
			}
			return preset;
		}
		return item;
	},
);

// 处理导航栏 Logo 图片
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) {
		logoImg = await file();
	}
}
---
<div id="navbar" class="z-50" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-enable-blur={String(navbarEnableBlur)} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <div class:list={[
        className,
        "overflow-visible! h-18 px-4"
    ]}>
        <div class="mx-auto h-full w-full max-w-(--page-width) grid grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            <a href={url('/')} id="nav-logo-link" data-nav-scroll="top" class="btn-plain scale-animation rounded-lg h-[3.5rem] px-4 font-bold active:scale-95">
                <div class:list={[
                    "flex flex-row items-center text-xl",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]}>
                                    {siteConfig.navbar.logo?.type === "icon" ? (
                                        <Icon name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} is:inline class="text-[1.75rem] mb-1 mr-2" />
                                    ) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
                                        <Picture
                                            src={logoImg}
                                            alt={siteConfig.navbar.logo.alt || siteConfig.title}
                                            class:list={[
                                                "h-12 w-12 mb-1 mr-3 object-contain drop-shadow-[0_0_1px_rgba(0,0,0,0.8)] dark:drop-shadow-[0_0_1px_rgba(255,255,255,0.8)]",
                                                siteConfig.navbar.followTheme ? "" : "invert hue-rotate-180 dark:invert-0 dark:hue-rotate-0"
                                            ]}
                                            formats={getImageFormats()}
                                            fallbackFormat={getFallbackFormat()}
                                            widths={[48, 96]}
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    ) : siteConfig.navbar.logo?.type === "image" ? (
                                        <img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class:list={["h-12 w-12 mb-1 mr-3 object-contain drop-shadow-[0_0_1px_rgba(0,0,0,0.8)] dark:drop-shadow-[0_0_1px_rgba(255,255,255,0.8)]", siteConfig.navbar.followTheme ? "" : "invert hue-rotate-180 dark:invert-0 dark:hue-rotate-0"]} fetchpriority="high" />
                                    ) : siteConfig.navbar.logo?.type === "url" ? (
                                        <img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class:list={["h-12 w-12 mb-1 mr-3 object-contain drop-shadow-[0_0_1px_rgba(0,0,0,0.8)] dark:drop-shadow-[0_0_1px_rgba(255,255,255,0.8)]", siteConfig.navbar.followTheme ? "" : "invert hue-rotate-180 dark:invert-0 dark:hue-rotate-0"]} fetchpriority="high" />
                                    ) : (
                                        <Icon name="material-symbols:home-pin-outline" is:inline class="text-[1.75rem] mb-1 mr-2" />
                                    )}
                    {navbarTitle}
                    <span class="nav-moon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M20.6 13.9A8.7 8.7 0 0 1 10.1 3.4a7.1 7.1 0 1 0 10.5 10.5Z"/></svg>
                    </span>
                </div>
            </a>
            <div class:list={[
                "hidden lg:flex items-center space-x-1 col-start-2",
                isNavbarMenuCentered
                    ? "justify-center"
                    : "justify-start pl-2"
            ]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <div class="flex col-start-3 justify-self-end">
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                <a 
                  href="https://blogs.quest" 
                  target="_blank" 
                  title="空间穿梭-随机访问BlogsClub成员博客"
                  class="btn-plain scale-animation rounded-lg h-11 w-11 flex items-center justify-center active:scale-90 space-shuttle-btn"
                >
                  <span class="shuttle-icon" role="img" aria-label="空间穿梭"></span>
                </a>
                {musicPlayerConfig.showInNavbar && (
                    <button aria-label={i18n(I18nKey.music)} class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="music-player-switch">
                        <Icon name="material-symbols:music-note-rounded" is:inline class="text-[1.25rem]"></Icon>
                    </button>
                )}
                {hasDisplaySettings && (
                        <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon name="material-symbols:palette-outline" is:inline class="text-[1.25rem]"></Icon>
                        </button>
                )}
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 lg:hidden!" id="nav-menu-switch">
                    <Icon name="material-symbols:menu-rounded" is:inline class="text-[1.25rem]"></Icon>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50">
                <MusicPlayer />
            </div>
        )}
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:load></DisplaySettings>
    </div>
</div>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let themeSwitchBtn = document.getElementById("scheme-switch");
    if (themeSwitchBtn) {
        themeSwitchBtn.onclick = function () {
            let themePanel = document.getElementById("theme-mode-panel");
            if (themePanel) {
                themePanel.classList.toggle("float-panel-closed");
            }
        };
    }

    document.addEventListener("click", function(event) {
        const panels = ["display-setting", "nav-menu-panel", "music-nav-panel", "theme-mode-panel"];
        const buttons = ["display-settings-switch", "nav-menu-switch", "music-player-switch", "scheme-switch"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    panel.classList.add("float-panel-closed");
                }
            }
        });
    });
}

loadButtonScript();

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    // 初始状态不强制加 scrolled，保持透明；滚动后再切换
    navbar.classList.remove('scrolled');

    let ticking = false;

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            navbar!.classList.remove('scrolled');
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        // 使用批量DOM操作优化性能
        if (scrollTop > threshold) {
            navbar!.classList.add('scrolled');
        } else {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 悬浮气泡导航：滚动收缩检测（独立于 semifull 透明模式，所有模式生效）
// 使用 any 挂到 window，避免修改全局类型声明文件
const navBubbleGlobal = window as any;

function initNavBubble() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    if (navBubbleGlobal.navBubbleScrollHandler) {
        window.removeEventListener('scroll', navBubbleGlobal.navBubbleScrollHandler as () => void);
        navBubbleGlobal.navBubbleScrollHandler = undefined;
    }

    let bubbleTicking = false;

    function updateBubbleState() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        navbar!.classList.toggle('nav-condensed', scrollTop > 48);
        bubbleTicking = false;
    }

    function requestBubbleTick() {
        if (!bubbleTicking) {
            requestAnimationFrame(updateBubbleState);
            bubbleTicking = true;
        }
    }

    navBubbleGlobal.navBubbleScrollHandler = requestBubbleTick as () => void;
    window.addEventListener('scroll', requestBubbleTick, { passive: true });
    updateBubbleState();
}

navBubbleGlobal.initNavBubble = initNavBubble;

// 当前页朱红小圆点：导航栏在 Swup 页面切换中不被替换，
// 服务端渲染的圆点会停留在首次加载的页面上，这里在客户端同步更新。
function updateNavActiveDots() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    const path = window.location.pathname;
    const logoLink = navbar.querySelector('.grid > a[href]');
    const homePath = logoLink ? new URL(logoLink.getAttribute('href'), window.location.origin).pathname : '/';
    const matches = (href) => {
        const p = new URL(href, window.location.origin).pathname;
        return p === path || (p !== homePath && path.startsWith(p.endsWith('/') ? p : p + '/'));
    };
    navbar.querySelectorAll('.dropdown-container').forEach((container) => {
        const mainLink = container.querySelector(':scope > a[href]');
        const mainButton = container.querySelector(':scope > button');
        let target = null;
        let active = false;
        if (mainLink) {
            target = mainLink;
            active = matches(mainLink.getAttribute('href'));
        } else if (mainButton) {
            target = mainButton;
            active = Array.from(container.querySelectorAll('.dropdown-menu a[href]')).some((a) => matches(a.getAttribute('href')));
        }
        if (!target) return;
        const dot = target.querySelector(':scope > .nav-active-dot');
        if (active && !dot) {
            const span = document.createElement('span');
            span.className = 'nav-active-dot';
            span.setAttribute('aria-hidden', 'true');
            target.appendChild(span);
        } else if (!active && dot) {
            dot.remove();
        }
    });
}

navBubbleGlobal.updateNavActiveDots = updateNavActiveDots;
document.addEventListener('swup:contentReplaced', updateNavActiveDots);
document.addEventListener('astro:page-load', updateNavActiveDots);

// 导航定位逻辑：
// - 点击 logo（data-nav-scroll="top"）回到首页并滚动到页面最顶部（大屏 Hero）
// - 点击"主页"tab（href 指向 homePath + #swup-container）回到首页并滚动到文章列表主体
// 跨页面点击时通过 sessionStorage 标记，在首页加载 / Swup 无刷新切换后执行滚动。
const NAV_SCROLL_FLAG = 'firefly:nav-scroll-target';

function navPrefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
}

function getNavHomePath() {
    const logo = document.getElementById('nav-logo-link');
    if (!logo) return '/';
    return new URL(logo.getAttribute('href'), window.location.origin).pathname;
}

function isOnNavHome() {
    return window.location.pathname === getNavHomePath();
}

function navScrollToTop() {
    window.scrollTo({ top: 0, behavior: navPrefersReducedMotion() ? 'auto' : 'smooth' });
}

function navScrollToMain() {
    const target = document.getElementById('swup-container') || document.getElementById('content-wrapper');
    if (!target) return;
    target.scrollIntoView({ behavior: navPrefersReducedMotion() ? 'auto' : 'smooth', block: 'start' });
}

// 跨页竞态修复（v6）：
// 旧实现 applyPendingNavScroll 在事件触发瞬间判断 isOnNavHome()，
// Swup 下 astro:page-load / contentReplaced 触发时 location.pathname 可能尚未更新，
// 导致提前 return 且标记永远不被消费。现改为：
// - 触发时只"启动 watcher"，不在事件瞬间做 pathname 判断；
// - watcher 轮询读取当前 location（最长 5 秒），确认到达首页后才消费标记并滚动；
// - 滚动落位同样轮询确认（Swup / 原生锚点可能重置滚动位置）；
// - watcher 幂等，重复触发不会叠加定时器。
let navScrollWatcherRunning = false;

function runNavScrollWatcher() {
    if (navScrollWatcherRunning) return;
    if (!sessionStorage.getItem(NAV_SCROLL_FLAG)) return;
    navScrollWatcherRunning = true;

    const startedAt = Date.now();
    const waitForHome = () => {
        const pending = sessionStorage.getItem(NAV_SCROLL_FLAG);
        if (!pending) {
            navScrollWatcherRunning = false;
            return;
        }
        if (!isOnNavHome()) {
            // 尚未到达首页（pathname 未更新 / 仍在旧页），继续等待
            const elapsed = Date.now() - startedAt;
            if (elapsed > 2500) {
                // 导航兜底：swup.navigate 偶发静默失效（实测其 SwupScriptsPlugin
                // 在首页抛未捕获异常），超时后强制整页跳转，确保可靠到达
                const homePath = getNavHomePath();
                window.location.href = pending === 'main' ? homePath + '#swup-container' : homePath;
                navScrollWatcherRunning = false;
                return;
            }
            setTimeout(waitForHome, 100);
            return;
        }
        // 已到首页：消费标记并滚动落位
        sessionStorage.removeItem(NAV_SCROLL_FLAG);
        navScrollWatcherRunning = false;
        const isSettled = () => {
            if (pending === 'top') return (window.pageYOffset || document.documentElement.scrollTop) < 2;
            const target = document.getElementById('swup-container') || document.getElementById('content-wrapper');
            return target ? Math.abs(target.getBoundingClientRect().top) < 8 : true;
        };
        let attempts = 0;
        const tick = () => {
            if (pending === 'main') navScrollToMain();
            else navScrollToTop();
            attempts += 1;
            if (attempts < 10 && !isSettled()) {
                setTimeout(tick, 250);
            }
        };
        tick();
    };
    waitForHome();
}

function applyPendingNavScroll() {
    runNavScrollWatcher();
}

function initNavScrollBehavior() {
    const navbar = document.getElementById('navbar');
    if (!navbar || navbar.dataset.navScrollBound === 'true') return;
    navbar.dataset.navScrollBound = 'true';
    const homePath = getNavHomePath();

    navbar.addEventListener('click', (event) => {
        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!anchor || !navbar.contains(anchor)) return;

        const closeMobilePanel = () => {
            document.getElementById('nav-menu-panel')?.classList.add('float-panel-closed');
        };

        // Logo：回到首页并滚动到最顶部 Hero
        if (anchor.dataset.navScroll === 'top') {
            if (isOnNavHome()) {
                event.preventDefault();
                closeMobilePanel();
                navScrollToTop();
            } else {
                sessionStorage.setItem(NAV_SCROLL_FLAG, 'top');
            }
            return;
        }

        // "主页"类入口：href 指向 homePath + #swup-container，定位到文章列表主体
        let parsed;
        try {
            parsed = new URL(anchor.getAttribute('href'), window.location.origin);
        } catch {
            return;
        }
        if (parsed.pathname === homePath && parsed.hash === '#swup-container') {
            if (isOnNavHome()) {
                event.preventDefault();
                closeMobilePanel();
                history.replaceState(null, '', parsed.pathname + parsed.hash);
                navScrollToMain();
            } else {
                // Swup 默认忽略带 hash 的链接，这里手动导航：
                // 优先走 Swup 无刷新切换，否则整页跳转；首页加载后由 applyPendingNavScroll 滚动
                event.preventDefault();
                sessionStorage.setItem(NAV_SCROLL_FLAG, 'main');
                const swup = navBubbleGlobal.swup;
                if (swup && typeof swup.navigate === 'function') {
                    swup.navigate(parsed.pathname);
                } else {
                    window.location.href = parsed.pathname + parsed.hash;
                }
            }
        }
    }, true);

    applyPendingNavScroll();
}

document.addEventListener('swup:contentReplaced', applyPendingNavScroll);
document.addEventListener('swup:page:view', applyPendingNavScroll);
document.addEventListener('astro:page-load', applyPendingNavScroll);
document.addEventListener('astro:page-load', initNavScrollBehavior);
window.addEventListener('load', applyPendingNavScroll);
// 短定时器兜底：事件全部错过时也能消费标记
setTimeout(applyPendingNavScroll, 600);
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavScrollBehavior);
    document.addEventListener('DOMContentLoaded', applyPendingNavScroll);
} else {
    initNavScrollBehavior();
    applyPendingNavScroll();
}


if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavBubble);
} else {
    initNavBubble();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

<style is:global>
    /* 空间穿梭图标：mask 方案——形状取自图标，颜色完全跟随按钮文字色
       （亮黑/暗白，悬停自动变为 --primary 金色），不再依赖 --hue 滤镜 */
    .space-shuttle-btn .shuttle-icon {
        display: block;
        height: 1.125rem;
        width: 1.41rem; /* 原图 65:52 等比 */
        background-color: currentColor;
        -webkit-mask: url("/assets/images/shuttle.png") no-repeat center / contain;
        mask: url("/assets/images/shuttle.png") no-repeat center / contain;
        transition: background-color 0.3s ease;
    }
    </style>

{
    import.meta.env.PROD && (
        <script is:inline data-swup-ignore-script define:vars={{ scriptUrl: url('/pagefind/pagefind.js') }}>
            {/* 你的 loadPagefind 函数的完整内容放在这里 */}
            async function loadPagefind() {
                try {
                    const response = await fetch(scriptUrl, { method: 'HEAD' });
                    if (!response.ok) {
                        throw new Error(`Pagefind script not found: ${response.status}`);
                    }
                    const pagefind = await import(scriptUrl);
                    await pagefind.options({
                        excerptLength: 20
                    });
                    window.pagefind = pagefind;
                    document.dispatchEvent(new CustomEvent('pagefindready'));
                    console.log('Pagefind loaded and initialized successfully, event dispatched.');
                } catch (error) {
                    console.error('Failed to load Pagefind:', error);
                    window.pagefind = {
                        search: () => Promise.resolve({ results: [] }),
                        options: () => Promise.resolve(),
                    };
                    document.dispatchEvent(new CustomEvent('pagefindloaderror'));
                    console.log('Pagefind load error, event dispatched.');
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadPagefind);
            } else {
                loadPagefind();
            }
        </script>
    )
}
