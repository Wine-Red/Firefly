---
// 全局星空 Canvas + 动效管理器 v5
// - 星空：细密星辰闪烁 + 流星池（同时多条），纯原生 Canvas，无依赖；
//   每块画布按 data-scroll-rate 做视差（fixed 全局星空慢速上漂，
//   Hero 内星空向下补偿滞后于文档）
// - 月亮单摆阻尼入场：屏外右侧沿圆周摆入，弹簧-阻尼物理积分
// - 滚动编舞（v5 经典视差）：正文随文档 1× 上移，Hero 各层附加
//   向下补偿分量按深度滞后（表观 0.5~0.8×），海报文字与正文同速；
//   月亮在 0.58× 滞后基础上叠加断绳式加速坠落（左下向、带旋转、不缩小）
// - 月亮淡出为滚动值的纯函数，任何滚动路径/导航路径下一致生效
// - 惯性：滚动值 lerp 平滑，滚动停止后有余韵
// 性能与体验：密度上限、离屏暂停、标签页隐藏暂停、
// Swup 切换自动重扫、prefers-reduced-motion 全量降级、移动端降密度
---

<canvas
	class="starfield starfield-global"
	data-density="0.000055"
	data-max-stars="150"
	data-meteors="true"
	data-scroll-rate="0.22"
	aria-hidden="true"></canvas>

<script>
	(() => {
		if ((window as any).__ch2Motion) return;

		const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)");
		const FINE_POINTER = window.matchMedia("(pointer: fine)");

		/* ---------------- 主题色 ---------------- */
		const palette = { gold: "#C8A45D", cream: "#F1E9D6", vermilion: "#B3392C", ink: "#101218" };
		function refreshPalette() {
			const cs = getComputedStyle(document.documentElement);
			palette.gold = cs.getPropertyValue("--gold").trim() || palette.gold;
			palette.cream = cs.getPropertyValue("--cream").trim() || palette.cream;
			palette.vermilion = cs.getPropertyValue("--vermilion").trim() || palette.vermilion;
		}
		function hexToRgba(hex: string, alpha: number) {
			const h = hex.replace("#", "");
			const v = h.length === 3 ? h.split("").map((c) => c + c).join("") : h;
			const n = Number.parseInt(v, 16);
			return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${alpha})`;
		}
		refreshPalette();
		new MutationObserver(refreshPalette).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		/* ---------------- 星空 ---------------- */
		interface Star { x: number; y: number; r: number; base: number; phase: number; speed: number; color: string; born: number }
		interface Meteor { x: number; y: number; vx: number; vy: number; life: number; maxLife: number; tail: number; bright: number }

		const METEOR_SLOTS = 2;

		class StarCanvas {
			canvas: HTMLCanvasElement;
			ctx: CanvasRenderingContext2D;
			stars: Star[] = [];
			meteors: (Meteor | null)[] = new Array(METEOR_SLOTS).fill(null);
			nextMeteorAt: number[] = new Array(METEOR_SLOTS).fill(0);
			visible = true;
			w = 0; h = 0;
			birth = performance.now();
			// 视差速率：星点纵向位移 = scrollY × rate。
			// fixed 全局层用正值（慢速上漂）；Hero 绝对定位层用负值（向下补偿、滞后文档）
			scrollRate = 0.2;
			ro: ResizeObserver;
			io: IntersectionObserver;

			constructor(canvas: HTMLCanvasElement) {
				this.canvas = canvas;
				this.ctx = canvas.getContext("2d")!;
				this.scrollRate = Number.parseFloat(canvas.dataset.scrollRate || "0.2") || 0;
				this.resize();
				this.spawn();
				this.ro = new ResizeObserver(() => { this.resize(); this.spawn(); this.drawStatic(); });
				this.ro.observe(canvas);
				this.io = new IntersectionObserver(
					(entries) => { this.visible = entries[0]?.isIntersecting ?? true; },
					{ rootMargin: "120px" },
				);
				this.io.observe(canvas);
				this.drawStatic();
			}

			get isMobile() { return window.innerWidth < 768; }

			resize() {
				const rect = this.canvas.getBoundingClientRect();
				this.w = Math.max(1, rect.width);
				this.h = Math.max(1, rect.height);
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				this.canvas.width = this.w * dpr;
				this.canvas.height = this.h * dpr;
				this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			}

			spawn() {
				const density = Number.parseFloat(this.canvas.dataset.density || "0.00006");
				const maxStars = Number.parseInt(this.canvas.dataset.maxStars || "150", 10);
				const scale = this.isMobile ? 0.55 : 1;
				const count = Math.max(10, Math.min(Math.round(this.w * this.h * density * scale), maxStars));
				const colors = [palette.cream, palette.cream, palette.gold, palette.gold, palette.gold, palette.vermilion];
				this.stars = [];
				for (let i = 0; i < count; i++) {
					this.stars.push({
						x: Math.random() * this.w,
						y: Math.random() * this.h,
						r: 0.4 + Math.random() * 1.1,
						base: 0.25 + Math.random() * 0.55,
						phase: Math.random() * Math.PI * 2,
						speed: 0.0006 + Math.random() * 0.0016,
						color: colors[Math.floor(Math.random() * colors.length)],
						born: this.birth + Math.random() * 1600,
					});
				}
				this.meteors = new Array(METEOR_SLOTS).fill(null);
				const now = performance.now();
				for (let s = 0; s < METEOR_SLOTS; s++) {
					this.nextMeteorAt[s] = now + 2500 + s * 2600 + Math.random() * 4000;
				}
			}

			drawStatic() {
				if (REDUCED.matches) this.draw(performance.now(), true);
			}

			draw(t: number, forceFull = false) {
				const ctx = this.ctx;
				ctx.clearRect(0, 0, this.w, this.h);
				// 星辰按画布视差速率漂移（全局层慢上漂，Hero 层向下补偿滞后）
				const drift = forceFull ? 0 : (window.scrollY || 0) * this.scrollRate;
				for (const s of this.stars) {
					const fadeIn = forceFull ? 1 : Math.min(1, Math.max(0, (t - s.born) / 1200));
					if (fadeIn <= 0) continue;
					const tw = forceFull ? 1 : 0.55 + 0.45 * Math.sin(t * s.speed + s.phase);
					ctx.fillStyle = hexToRgba(s.color, s.base * tw * fadeIn);
					ctx.beginPath();
					ctx.arc(s.x + drift * 0.35, s.y - drift, s.r, 0, Math.PI * 2);
					ctx.fill();
				}
				// 流星池：多条并存，方向/长度/亮度各异
				if (!forceFull && this.canvas.dataset.meteors === "true" && !this.isMobile) {
					for (let slot = 0; slot < METEOR_SLOTS; slot++) {
						if (!this.meteors[slot] && t >= this.nextMeteorAt[slot]) {
							const fromLeft = Math.random() > 0.5;
							const speed = 0.3 + Math.random() * 0.3;
							this.meteors[slot] = {
								x: fromLeft ? -40 : this.w + 40,
								y: Math.random() * this.h * 0.45,
								vx: (fromLeft ? 1 : -1) * speed,
								vy: speed * (0.3 + Math.random() * 0.3),
								life: 0,
								maxLife: 800 + Math.random() * 600,
								tail: 60 + Math.random() * 80,
								bright: 0.5 + Math.random() * 0.4,
							};
						}
						const m = this.meteors[slot];
						if (m) {
							m.life += 16.7;
							m.x += m.vx * 16.7;
							m.y += m.vy * 16.7;
							const progress = m.life / m.maxLife;
							const alpha = (progress < 0.2 ? progress / 0.2 : 1 - (progress - 0.2) / 0.8) * m.bright;
							const grad = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * m.tail, m.y - m.vy * m.tail);
							grad.addColorStop(0, hexToRgba(palette.cream, Math.max(0, alpha * 0.85)));
							grad.addColorStop(1, hexToRgba(palette.gold, 0));
							ctx.strokeStyle = grad;
							ctx.lineWidth = 1.2;
							ctx.beginPath();
							ctx.moveTo(m.x, m.y);
							ctx.lineTo(m.x - m.vx * m.tail, m.y - m.vy * m.tail);
							ctx.stroke();
							if (m.life >= m.maxLife || m.x < -160 || m.x > this.w + 160 || m.y > this.h + 160) {
								this.meteors[slot] = null;
								this.nextMeteorAt[slot] = t + 2500 + Math.random() * 4000 + slot * 1400;
							}
						}
					}
				}
			}

			destroy() {
				this.ro.disconnect();
				this.io.disconnect();
			}
		}

		const instances = new Map<HTMLCanvasElement, StarCanvas>();

		function scanStarfields() {
			document.querySelectorAll<HTMLCanvasElement>("canvas.starfield").forEach((canvas) => {
				if (!instances.has(canvas)) {
					instances.set(canvas, new StarCanvas(canvas));
				}
			});
			// 清理被 Swup 移除的实例
			for (const [canvas, inst] of instances) {
				if (!canvas.isConnected) {
					inst.destroy();
					instances.delete(canvas);
				}
			}
		}

		/* ---------------- 月亮单摆入场 ----------------
		   月亮拴在看不见的绳子上：支点在最终位正上方 L 处，
		   从屏幕右上方（θ0≈1.35rad）沿圆周摆入，阻尼振荡至稳定。
		   渲染技巧：CSS 已把月亮定位在最终位，JS 只写相对偏移
		   translate3d(L·sinθ, L·(cosθ−1), 0)，θ=0 时偏移为零。 */
		interface Pendulum { theta: number; omega: number; t: number; L: number }
		let pendulum: Pendulum | null = null;
		const PEND_G = 2600; // px/s²
		const PEND_C = 0.9; // 阻尼系数（轻度欠阻尼，过冲 2~3 次）
		const PEND_THETA0 = 1.35;
		let moonArts: HTMLElement[] = [];

		/* 月落淡出：滚动值的纯函数（0.3vh 起淡，0.72vh 全隐）。
		   摆入与月落共用同一函数——任何滚动路径、任何互斥状态下，
		   月亮 opacity 永远由当前滚动位置决定，不会卡在 1。 */
		function moonFadeAt(sS: number, vh: number) {
			return 1 - Math.min(Math.max((sS - vh * 0.3) / (vh * 0.42), 0), 1);
		}

		function applyPendulum(moon: HTMLElement, p: Pendulum) {
			const dx = p.L * Math.sin(p.theta);
			const dy = p.L * (Math.cos(p.theta) - 1);
			moon.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
			// opacity 跟随月落函数而非硬编码 1：摆入中若处于滚动位也不会异常显形
			moon.style.opacity = moonFadeAt(Math.max(window.scrollY || 0, 0), window.innerHeight || 1).toFixed(3);
			const rot = (p.theta * 0.28 * 57.2958).toFixed(2);
			for (const art of moonArts) art.style.transform = `rotate(${rot}deg)`;
		}

		function initPendulum() {
			const moon = document.querySelector<HTMLElement>("[data-ch3-moon]");
			if (!moon) return;
			// reduced-motion：不起摆，但必须现身（CSS 默认 opacity:0 防闪现）
			if (REDUCED.matches) { moon.style.opacity = "1"; return; }
			if (pendulum) return; // 摆入进行中不被 page-load 重置
			// 已在滚动位（刷新恢复滚动/迟到的 page-load）：不起摆，
			// 交给月落编舞按滚动值决定显隐，避免月亮瞬移屏外或卡在全亮
			if ((window.scrollY || 0) > 40) return;
			moonArts = Array.from(moon.querySelectorAll<HTMLElement>(".ch3-moon-art"));
			pendulum = {
				theta: PEND_THETA0,
				omega: 0,
				t: 0,
				L: (window.innerHeight || 800) * 0.9,
			};
			applyPendulum(moon, pendulum); // 立即摆到屏外初始位，避免闪现最终位
		}

		function finishPendulum() {
			pendulum = null;
			for (const art of moonArts) art.style.transform = "";
			lastWritten = -1; // 强制编舞下一帧把月亮写到精确最终位，避免跳变
		}

		function stepPendulum(dt: number) {
			if (!pendulum) return;
			const moon = moonEl;
			if (!moon || !moon.isConnected) { finishPendulum(); return; }
			// 用户提前滚动：直接结束摆入，编舞无缝接管
			if ((window.scrollY || 0) > 40) { finishPendulum(); return; }
			pendulum.t += dt;
			// 阻尼递增：3.2s 后绳子"沾上空气阻力"，残余摆动平滑收敛，
			// 避免硬 cutoff 时从可见偏移瞬跳到零
			const damp = PEND_C + Math.max(0, pendulum.t - 3.2) * 2.2;
			const accel = -(PEND_G / pendulum.L) * Math.sin(pendulum.theta) - damp * pendulum.omega;
			pendulum.omega += accel * dt;
			pendulum.theta += pendulum.omega * dt;
			applyPendulum(moon, pendulum);
			const settled = pendulum.t > 1.2 && Math.abs(pendulum.theta) < 0.012 && Math.abs(pendulum.omega) < 0.04;
			if (settled || pendulum.t > 8) finishPendulum();
		}

		/* ---------------- 滚动编舞 ----------------
		   v5 经典视差：Hero 各层附加"跟随滚动但减速"的向下补偿分量
		   （data-ch3-drift y>0，表观速度=1−y），正文随文档 1× 自然滚动、
		   海报文字同速；月亮在滞后基础上断绳坠落，正文条目从地平线升起。
		   全部为滚动值的纯函数，滚回顶部自然复位；滚动值经 lerp 平滑带惯性。 */
		interface DriftLayer { el: HTMLElement; yRate: number; xRate: number; fadeLen: number }
		interface RiseItem { el: HTMLElement; index: number }
		let driftLayers: DriftLayer[] = [];
		let riseItems: RiseItem[] = [];
		let moonEl: HTMLElement | null = null;
		let sSmooth = -1;
		let lastWritten = -1;

		function scanChoreo() {
			driftLayers = [];
			riseItems = [];
			moonEl = document.querySelector<HTMLElement>("[data-ch3-moon]");
			document.querySelectorAll<HTMLElement>("[data-ch3-drift]").forEach((el) => {
				const [y, f, x] = (el.dataset.ch3Drift || "0 1 0").split(/\s+/).map(Number);
				driftLayers.push({ el, yRate: y || 0, fadeLen: f || 1, xRate: x || 0 });
			});
			// 正文条目：从地平线升起联动（inline style 驱动，JS 失效时天然可见）
			document.querySelectorAll<HTMLElement>("#post-list-container .post-card-wrapper").forEach((el, i) => {
				riseItems.push({ el, index: i });
			});
			sSmooth = -1; // 强制下一帧重算
			lastWritten = -1;
		}

		function updateChoreo(t: number) {
			const s = window.scrollY || 0;
			if (sSmooth < 0) sSmooth = s;
			sSmooth += (s - sSmooth) * 0.14;
			if (Math.abs(s - sSmooth) < 0.1) sSmooth = s;
			// 短路：滚动值稳定且摆入不活跃时无需重写
			if (!pendulum && sSmooth === lastWritten) return;
			lastWritten = sSmooth;
			const sS = sSmooth;
			const vh = window.innerHeight || 1;

			if (moonEl) {
				if (!moonEl.isConnected) {
					moonEl = null;
				} else if (!pendulum) {
					// 视差滞后：月亮以 0.58× 表观速度随文档上移（向下补偿 sS*0.42），
					// 衔接段与正文一起向上但更慢；断绳坠落叠加其上：
					// p² 重力加速，斜向左下，带翻滚，不缩小
					const p = Math.min(Math.max(sS / (vh * 0.9), 0), 1);
					const acc = p * p;
					const lagY = Math.max(sS, 0) * 0.42;
					const fall = acc * vh * 0.85;
					const driftX = -acc * vh * 0.42;
					const rot = p * 34;
					const fade = moonFadeAt(sS, vh);
					// 悬挂时的呼吸微摆（随坠落渐隐）
					const sway = Math.sin(t * 0.0008) * 0.6 * fade;
					moonEl.style.transform =
						`translate3d(${driftX.toFixed(1)}px, ${(lagY + fall).toFixed(1)}px, 0) rotate(${(rot + sway).toFixed(2)}deg)`;
					moonEl.style.opacity = fade.toFixed(3);
				}
			}

			for (const layer of driftLayers) {
				if (!layer.el.isConnected) continue;
				const ty = sS * layer.yRate;
				const tx = sS * layer.xRate;
				const fade = layer.fadeLen > 0 ? 1 - Math.min(sS / (vh * layer.fadeLen), 1) : 1;
				layer.el.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0)`;
				layer.el.style.opacity = fade.toFixed(3);
			}

			// 正文条目 stagger 升起（完成态清空 inline，归还 CSS hover 控制）
			const riseStart = vh * 0.22;
			for (const item of riseItems) {
				if (!item.el.isConnected) continue;
				const p = Math.min(Math.max((sS - (riseStart + item.index * vh * 0.065)) / (vh * 0.38), 0), 1);
				if (p >= 1) {
					if (item.el.style.opacity !== "") {
						item.el.style.opacity = "";
						item.el.style.transform = "";
					}
					continue;
				}
				const e = 1 - Math.pow(1 - p, 3);
				item.el.style.opacity = e.toFixed(3);
				item.el.style.transform = `translate3d(0, ${((1 - e) * 56).toFixed(1)}px, 0)`;
			}
		}

		if (!REDUCED.matches) {
			let lastT = 0;
			const loop = (t: number) => {
				const dt = Math.min((t - lastT) / 1000, 0.032);
				lastT = t;
				if (!document.hidden) {
					stepPendulum(dt);
					updateChoreo(t);
					for (const inst of instances.values()) {
						if (inst.visible) inst.draw(t);
					}
				}
				requestAnimationFrame(loop);
			};
			requestAnimationFrame(loop);
		}

		/* ---------------- Hero 鼠标 3D 倾斜 ---------------- */
		let tiltTarget: { rx: number; ry: number } | null = null;
		let tiltCurrent: { rx: number; ry: number } = { rx: 0, ry: 0 };
		let tiltRaf = 0;

		function tiltLoop() {
			if (!tiltTarget) { tiltRaf = 0; return; }
			tiltCurrent.rx += (tiltTarget.rx - tiltCurrent.rx) * 0.08;
			tiltCurrent.ry += (tiltTarget.ry - tiltCurrent.ry) * 0.08;
			const hero = document.querySelector<HTMLElement>("[data-ch3-tilt]");
			if (hero) {
				hero.style.transform =
					`rotateX(${tiltCurrent.rx.toFixed(3)}deg) rotateY(${tiltCurrent.ry.toFixed(3)}deg)`;
			}
			if (Math.abs(tiltTarget.rx - tiltCurrent.rx) > 0.01 || Math.abs(tiltTarget.ry - tiltCurrent.ry) > 0.01) {
				tiltRaf = requestAnimationFrame(tiltLoop);
			} else {
				tiltRaf = 0;
			}
		}

		if (FINE_POINTER.matches && !REDUCED.matches) {
			document.addEventListener(
				"pointermove",
				(e) => {
					const hero = document.querySelector<HTMLElement>("[data-ch3-hero]");
					if (!hero) return;
					const rect = hero.getBoundingClientRect();
					if (rect.bottom < 0 || rect.top > window.innerHeight) {
						if (tiltTarget) { tiltTarget = { rx: 0, ry: 0 }; if (!tiltRaf) tiltRaf = requestAnimationFrame(tiltLoop); }
						return;
					}
					const px = (e.clientX - rect.left) / rect.width - 0.5;
					const py = (e.clientY - rect.top) / rect.height - 0.5;
					// 幅度克制：最大 ±1.8deg
					tiltTarget = { rx: (-py * 3.6), ry: (px * 3.6) };
					if (!tiltRaf) tiltRaf = requestAnimationFrame(tiltLoop);
				},
				{ passive: true },
			);
			document.addEventListener("pointerleave", () => {
				tiltTarget = { rx: 0, ry: 0 };
				if (!tiltRaf) tiltRaf = requestAnimationFrame(tiltLoop);
			});
		}

		/* ---------------- 滚动 reveal ---------------- */
		const revealIO = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add("ch3-revealed");
						revealIO.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
		);

		function scanReveals() {
			const targets = document.querySelectorAll<HTMLElement>(
				"widget-layout:not(.onload-animation), [data-ch3-reveal]",
			);
			targets.forEach((el) => {
				if (el.classList.contains("ch3-reveal") || el.classList.contains("ch3-revealed")) return;
				if (REDUCED.matches) {
					el.classList.add("ch3-revealed");
					return;
				}
				el.classList.add("ch3-reveal");
				revealIO.observe(el);
			});
		}

		/* ---------------- 生命周期 ---------------- */
		function rescan() {
			scanStarfields();
			scanChoreo();
			scanReveals();
		}

		initPendulum(); // 首次加载：若有月亮立即起摆（必须在 rescan 前，先占住屏外位）
		rescan();
		// astro:page-load 在首次加载也会触发（且可能很晚，swup 模块慢加载后）。
		// 首次触发跳过起摆——否则摆入稳定后会突然瞬移屏外重摆；
		// 之后的事件才是 Swup 导航回首页，允许重摆。
		let firstPageLoad = true;
		document.addEventListener("astro:page-load", () => {
			if (firstPageLoad) {
				firstPageLoad = false;
				rescan();
				return;
			}
			initPendulum(); // Swup 导航回首页时重新摆入
			rescan();
		});
		document.addEventListener("swup:contentReplaced", () => setTimeout(rescan, 50));

		(window as any).__ch2Motion = true;
	})();
</script>
