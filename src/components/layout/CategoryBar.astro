---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

interface Props {
	currentPostCategory?: string;
}

const { currentPostCategory } = Astro.props as Props;

const categories = await getCategoryList();
// 提取置顶分类并与其他分类分开
const highlightNames = ["AI日报", "热门仓库"];
const highlightedCategories = categories.filter((cat) =>
	highlightNames.includes(cat.name),
);
const normalCategories = categories.filter(
	(cat) => !highlightNames.includes(cat.name),
);

// 按照 highlightNames 的顺序对置顶分类进行排序
highlightedCategories.sort(
	(a, b) => highlightNames.indexOf(a.name) - highlightNames.indexOf(b.name),
);

const totalPosts = (await getSortedPostsList()).length;
const homeUrl = url("/");
const originalUrl = url("/original/");
const archiveUrl = url("/archive/");
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-home-path={homeUrl}
  data-original-path={originalUrl}
  data-archive-path={archiveUrl}
  data-current-post-category={currentPostCategory || ""}
>
  <div class="category-bar-inner flex gap-2">
    <a
      href={homeUrl}
      class="category-pill text-sm px-2 py-1 rounded-lg shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name=""
      aria-label={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home-outline" class="text-[1.25rem]" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__archive__"
    >
      {i18n(I18nKey.archive)}
      <span class="text-xs opacity-60 ml-1">{totalPosts}</span>
    </a>
    <div class="category-divider shrink-0"></div>
    <div class="scroll-area relative">
      <div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
      <div class="category-scroll flex gap-2 overflow-x-auto">
        {/* 渲染置顶高亮的分类 */}
        {
          highlightedCategories.map((cat) => (
            <a
              href={cat.url}
              class="category-pill highlight-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap
                     transition-colors duration-150 ease-out flex items-center justify-center relative overflow-hidden"
              data-category-name={cat.name}
            >
              <div class="absolute inset-0 bg-gradient-to-r from-blue-500/10 to-purple-500/10 dark:from-blue-400/10 dark:to-purple-400/10 z-0"></div>
              <span class="relative z-10 font-medium text-blue-700 dark:text-blue-300">{cat.name}</span>
              <span class="relative z-10 text-xs opacity-70 ml-1.5 text-blue-600 dark:text-blue-400">{cat.count}</span>
            </a>
          ))
        }
        
        {/* 如果有置顶分类和普通分类，添加一个小的视觉分隔 */}
        {highlightedCategories.length > 0 && normalCategories.length > 0 && (
          <div class="w-px h-4 bg-black/10 dark:bg-white/10 self-center mx-1"></div>
        )}

        {/* 渲染普通分类 */}
        {
          normalCategories.map((cat) => (
            <a
              href={cat.url}
              class="category-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap
                     transition-colors duration-150 ease-out flex items-center justify-center"
              data-category-name={cat.name}
            >
              {cat.name}
              <span class="text-xs opacity-60 ml-1">{cat.count}</span>
            </a>
          ))
        }
      </div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
    </div>
    
    <div id="ai-filter-wrap" class="flex items-center overflow-hidden transition-all duration-300 ease-out origin-right" style="max-width: 150px; opacity: 1; transform: translateX(0);">
      <div class="category-divider shrink-0 mr-2"></div>
      <button 
        id="ai-filter-btn"
        class="category-pill text-sm px-3 py-1 rounded-lg shrink-0 transition-colors duration-150 ease-out flex items-center justify-center gap-1"
        aria-label="Toggle AI Posts"
        title="隐藏 AI 生成的文章"
      >
        <!-- 内联 SVG：不依赖 astro-icon 全页 symbol 去重，过滤换列表后图标不丢失 -->
        <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="currentColor" aria-hidden="true"><path d="M5 21q-.425 0-.712-.288T4 20v-4q0-.825.588-1.412T6 14h12q.825 0 1.413.588T20 16v4q0 .425-.288.713T19 21zm4-8q-2.075 0-3.537-1.463T4 8t1.463-3.537T9 3h6q2.075 0 3.538 1.463T20 8t-1.463 3.538T15 13zm-3 6h12v-3H6zm3-8h6q1.25 0 2.125-.875T18 8t-.875-2.125T15 5H9q-1.25 0-2.125.875T6 8t.875 2.125T9 11m.713-2.287Q10 8.425 10 8t-.288-.712T9 7t-.712.288T8 8t.288.713T9 9t.713-.288m6 0Q16 8.426 16 8t-.288-.712T15 7t-.712.288T14 8t.288.713T15 9t.713-.288M12 8"/></svg>
        <span class="hidden md:inline">过滤 AI</span>
      </button>
    </div>
  </div>
</div>

<style>
  #ai-filter-wrap.hide-filter {
    max-width: 0 !important;
    opacity: 0 !important;
    transform: translateX(20px) !important;
    pointer-events: none;
    margin-left: -0.5rem; /* 抵消父元素的 gap-2 (0.5rem) */
  }
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
  }
  .scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease-in-out;
    z-index: 1;
  }
  .scroll-fade[data-visible] {
    opacity: 1;
  }
  .scroll-fade-left {
    left: 0;
    background: linear-gradient(to left, transparent, var(--card-bg));
  }
  .scroll-fade-right {
    right: 0;
    background: linear-gradient(to right, transparent, var(--card-bg));
  }
  :global(body.wallpaper-transparent) .scroll-fade {
    display: none;
  }
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-pill {
    border: 1.5px solid var(--line-divider);
    color: var(--btn-content);
    background: transparent;
  }
  .category-pill:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: transparent;
  }
  .category-pill[data-active] {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }
  .category-pill[data-soft-active] {
    border-color: var(--line-divider);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    color: color-mix(in srgb, var(--primary) 72%, var(--btn-content));
  }
  .category-pill[data-soft-active]:hover {
    border-color: var(--line-divider);
    background: color-mix(in srgb, var(--primary) 15%, transparent);
    color: color-mix(in srgb, var(--primary) 82%, var(--btn-content));
  }
  .category-pill[data-soft-active][data-active],
  .category-pill[data-soft-active][data-active]:hover {
    border-color: var(--line-divider);
    background: color-mix(in srgb, var(--primary) 15%, transparent);
    color: color-mix(in srgb, var(--primary) 82%, var(--btn-content));
  }
  .category-pill[data-active]:hover {
    background: var(--primary);
    border-color: var(--primary);
    opacity: 0.9;
  }
  .category-pill.highlight-pill {
    border-color: color-mix(in srgb, var(--primary) 30%, transparent);
  }
  .category-pill.highlight-pill:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 5%, transparent);
  }
  .category-pill.highlight-pill[data-active] {
    background: var(--primary);
    border-color: var(--primary);
  }
  .category-pill.highlight-pill[data-active] span {
    color: white !important;
  }
</style>

<script>
  let delayedCategoryBarScrollTimer: number | undefined;

  function normalizeListingPath(pathname: string) {
    const normalized = pathname.replace(/\/+$/, "");
    return normalized || "/";
  }

  function isPaginatedListingPath(pathname: string, listingPath: string) {
    const normalizedPath = normalizeListingPath(pathname);
    const normalizedListingPath = normalizeListingPath(listingPath);
    if (normalizedPath === normalizedListingPath) return true;

    const pageSuffix = normalizedPath.slice(normalizedListingPath === "/" ? 0 : normalizedListingPath.length);
    return /^\/\d+$/.test(pageSuffix);
  }

  function getCategoryBarState(bar: HTMLElement, currentUrl: URL) {
    const pathname = normalizeListingPath(currentUrl.pathname);
    const homePath = bar.getAttribute("data-home-path") || "/";
    const originalPath = bar.getAttribute("data-original-path") || "/original/";
    const archivePath = normalizeListingPath(bar.getAttribute("data-archive-path") || "/archive/");
    const isHome = isPaginatedListingPath(pathname, homePath);
    const isOriginal = isPaginatedListingPath(pathname, originalPath);
    const isArchive = pathname === archivePath;

    return {
      isHome,
      isOriginal,
      isArchive,
      activeCategory: currentUrl.searchParams.get("category") || "",
      hasTag: currentUrl.searchParams.has("tag"),
      hasUncategorized: currentUrl.searchParams.has("uncategorized"),
    };
  }

  // 类型筛选栏只在主页（含分页与 /original/）和归档页显示，其余页面整条隐藏
  function updateBarVisibility(bar: HTMLElement, currentUrl: URL) {
    const wrapper = document.getElementById("category-bar-wrapper");
    if (!wrapper) return;
    const { isHome, isOriginal, isArchive } = getCategoryBarState(bar, currentUrl);
    wrapper.style.display = isHome || isOriginal || isArchive ? "" : "none";
  }

  function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
    const { isHome, isOriginal, isArchive, activeCategory, hasTag, hasUncategorized } =
      getCategoryBarState(bar, currentUrl);
    const postCategory = (bar.getAttribute("data-current-post-category") || "").trim();

    const pills = bar.querySelectorAll<HTMLAnchorElement>("a.category-pill");
    pills.forEach((pill) => {
      pill.removeAttribute("data-active");
      pill.removeAttribute("data-soft-active");
    });

    if (isHome || isOriginal) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name=""]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (activeCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === activeCategory) {
          pill.setAttribute("data-active", "");
        }
      });
      return;
    }

    if (isArchive && !hasTag && !hasUncategorized) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (postCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === postCategory) {
          pill.setAttribute("data-soft-active", "");
        }
      });
    }
  }

  function scrollActiveCategoryIntoView(bar: HTMLElement, behavior: ScrollBehavior = "smooth") {
    const activePill =
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-active]') ||
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-soft-active]');
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!activePill || !scroll) return;

		// Only move when clipped. Centering every active pill pushed the first
		// categories underneath the desktop fade even when there was enough room.
		const scrollRect = scroll.getBoundingClientRect();
		const pillRect = activePill.getBoundingClientRect();
		const safeInset = 12;
		let delta = 0;
		if (pillRect.left < scrollRect.left + safeInset) {
			delta = pillRect.left - scrollRect.left - safeInset;
		} else if (pillRect.right > scrollRect.right - safeInset) {
			delta = pillRect.right - scrollRect.right + safeInset;
		}
		if (Math.abs(delta) > 1) {
			scroll.scrollBy({ left: delta, behavior });
		}
  }

  function shouldDeferCategoryScroll(bar: HTMLElement, currentUrl: URL) {
    const { isHome, isOriginal } = getCategoryBarState(bar, currentUrl);
    const isMobile = window.innerWidth < 1024;
    const isBannerMode = document.body.classList.contains("enable-banner");
    return isMobile && isBannerMode && !isHome && !isOriginal;
  }

  function updateCategoryBar(
    currentUrl = new URL(window.location.href),
    options: { scrollBehavior?: ScrollBehavior; deferScroll?: boolean } = {},
  ) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const swupContainer = document.getElementById("swup-container");
    if (swupContainer) {
      const currentPostCategory = swupContainer.getAttribute("data-current-post-category") || "";
      bar.setAttribute("data-current-post-category", currentPostCategory);
    }

    updateBarVisibility(bar, currentUrl);
    setActiveCategory(bar, currentUrl);

    const deferScroll = options.deferScroll ?? shouldDeferCategoryScroll(bar, currentUrl);
    const scrollBehavior = options.scrollBehavior ?? (deferScroll ? "auto" : "smooth");

    if (delayedCategoryBarScrollTimer) {
      window.clearTimeout(delayedCategoryBarScrollTimer);
      delayedCategoryBarScrollTimer = undefined;
    }

    if (deferScroll) {
      // 等主内容上移完成后再定位分类，避免出现“先横向滚动后上移”的卡顿观感。
      delayedCategoryBarScrollTimer = window.setTimeout(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            scrollActiveCategoryIntoView(bar, scrollBehavior);
            updateScrollHint();
          });
        });
      }, 220);
      return;
    }

    scrollActiveCategoryIntoView(bar, scrollBehavior);
    updateScrollHint();
  }

  function initCategoryBarInteractions() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.clickBound === "true") return;

    bar.dataset.clickBound = "true";
    bar.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const pill = event.target.closest<HTMLAnchorElement>("a.category-pill");
      if (!pill) return;

      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      if (pill.target && pill.target !== "_self") return;

      const targetUrl = new URL(pill.href, window.location.href);
      if (targetUrl.origin !== window.location.origin) return;

      setActiveCategory(bar, targetUrl);
      scrollActiveCategoryIntoView(bar, "auto");
    });
  }

  function initScrollFeatures() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!scroll) return;

    if (scroll.dataset.featuresBound === "true") {
      updateScrollHint();
      return;
    }
    scroll.dataset.featuresBound = "true";

    // 鼠标滚轮横向滚动
    scroll.addEventListener("wheel", (e) => {
      if (scroll.scrollWidth <= scroll.clientWidth) return;
      e.preventDefault();
      scroll.scrollLeft += e.deltaY;
    }, { passive: false });

    // 监听滚动更新提示图标
    scroll.addEventListener("scroll", updateScrollHint);
    window.addEventListener("resize", updateScrollHint);
    updateScrollHint();
  }

  function updateScrollHint() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left");
    const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right");
    if (!scroll || !fadeLeft || !fadeRight) return;

    const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1;
    const atStart = scroll.scrollLeft <= 1;
    const atEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1;

    if (hasOverflow && !atStart) {
      fadeLeft.setAttribute("data-visible", "");
    } else {
      fadeLeft.removeAttribute("data-visible");
    }

    if (hasOverflow && !atEnd) {
      fadeRight.setAttribute("data-visible", "");
    } else {
      fadeRight.removeAttribute("data-visible");
    }
  }

  updateCategoryBar();
  initCategoryBarInteractions();
  initScrollFeatures();
  document.addEventListener("astro:page-load", () => {
    updateCategoryBar();
    initScrollFeatures();
  });
  document.addEventListener("swup:contentReplaced", () => {
    updateCategoryBar();
    // 某些 swup 生命周期下 URL/DOM 状态同步稍晚，下一帧再校正一次避免状态残留
    requestAnimationFrame(() => {
      updateCategoryBar();
    });
  });

  // 在 Swup 导航时提前更新状态，避免切换期间激活态闪烁
  function setupSwupEarlyUpdate() {
    if (!window.swup?.hooks) return;
    window.swup.hooks.on("visit:start", (visit: any) => {
      const bar = document.getElementById("category-bar");
      if (!bar) return;
			const triggerElement = visit.trigger?.el;
			const isCategoryNavigation =
				triggerElement instanceof Element && !!triggerElement.closest("#category-bar");
			if (isCategoryNavigation || visit.meta?.preserveCategoryScroll) {
				visit.scroll.reset = false;
			}
      const targetUrl = new URL(visit.to.url, window.location.href);
      updateBarVisibility(bar, targetUrl);
      setActiveCategory(bar, targetUrl);
      
      // 在页面跳转前提前触发过滤按钮的动画
      const wrap = document.getElementById("ai-filter-wrap");
      if (wrap) {
        const { isHome, isOriginal, isArchive } = getCategoryBarState(bar, targetUrl);
        if (!isHome && !isOriginal && !isArchive) {
          wrap.classList.add("hide-filter");
        } else {
          wrap.classList.remove("hide-filter");
        }
      }
    });
  }
  if (window.swup?.hooks) {
    setupSwupEarlyUpdate();
  } else {
    document.addEventListener("swup:enable", setupSwupEarlyUpdate);
  }

  // AI 过滤逻辑（原地过滤，不再跳转 /original/）
  const AI_FILTER_STATE_KEY = "aiFilterInPlace";
  const AI_FILTER_CHANGE_EVENT = "firefly:ai-filter-change";
  // 跨 Swup 导航缓存原创列表 HTML（原创文章少，/original/ 第一页即可覆盖）
  let cachedOriginalDoc: Document | null = null;
  let originalListFetchPromise: Promise<Document | null> | null = null;
  // 进入过滤态前备份当前页完整列表，退出时恢复
  let fullListBackupHTML: string | null = null;

  function isAIFilterActive() {
    try {
      // 未设置时默认过滤 AI；显式关闭后才展示全部文章。
      return sessionStorage.getItem(AI_FILTER_STATE_KEY) !== "0";
    } catch {
      return true;
    }
  }

  function setAIFilterActive(active: boolean) {
    try {
      sessionStorage.setItem(AI_FILTER_STATE_KEY, active ? "1" : "0");
    } catch {
      /* sessionStorage 不可用时静默降级 */
    }
    window.dispatchEvent(
      new CustomEvent(AI_FILTER_CHANGE_EVENT, { detail: { active } }),
    );
  }

  function updateAIFilterButton(btn: HTMLElement, filtered: boolean) {
    if (filtered) {
      btn.setAttribute("data-active", "");
      btn.setAttribute("title", "显示全部文章");
    } else {
      btn.removeAttribute("data-active");
      btn.setAttribute("title", "隐藏 AI 生成的文章");
    }
  }

  async function fetchOriginalDoc(originalPath: string): Promise<Document | null> {
    if (cachedOriginalDoc) return cachedOriginalDoc;
    if (!originalListFetchPromise) {
      originalListFetchPromise = (async () => {
        try {
          const res = await fetch(originalPath, { credentials: "same-origin" });
          if (!res.ok) return null;
          const doc = new DOMParser().parseFromString(await res.text(), "text/html");
          const src = doc.getElementById("post-list-container");
          // 校验确实是文章列表（带 data-is-ai 标记的卡片），避免把 404/错误页注入首页
          if (!src || !src.querySelector("[data-is-ai]")) return null;
          cachedOriginalDoc = doc;
          return cachedOriginalDoc;
        } catch {
          return null;
        }
      })();
    }
    return originalListFetchPromise;
  }

  // astro-icon 全页去重：symbol 定义只保留在页面首次出现处（可能在本组件按钮里）。
  // 注入来源页 HTML 时补齐文档中缺失的 symbol 定义，避免 <use href="#ai:..."> 失引用导致图标消失。
  function injectWithIconSymbols(container: HTMLElement, html: string, sourceDoc: Document) {
    const refIds = new Set<string>();
    for (const m of html.matchAll(/href="#(ai:[^"]+)"/g)) {
      refIds.add(m[1]);
    }
    const missingDefs: string[] = [];
    refIds.forEach((id) => {
      if (document.getElementById(id)) return;
      const sym = sourceDoc.querySelector(`symbol[id="${id}"]`);
      if (sym) missingDefs.push(sym.outerHTML);
    });
    if (missingDefs.length > 0) {
      html =
        `<svg width="0" height="0" style="position:absolute" aria-hidden="true">${missingDefs.join("")}</svg>` +
        html;
    }
    container.innerHTML = html;
  }

  // 过滤态下隐藏分页器（原创列表很短，无需分页）
  function setPaginationHidden(hidden: boolean) {
    document
      .querySelectorAll<HTMLElement>('[role="navigation"]')
      .forEach((nav) => {
        const wrapper = nav.parentElement;
        if (wrapper && wrapper.id !== "post-list-container") {
          wrapper.style.display = hidden ? "none" : "";
        }
      });
  }

  // 带淡入淡出的列表内容替换，与全站动效保持一致
  function swapPostList(container: HTMLElement, html: string, sourceDoc?: Document) {
    container.style.opacity = "0";
    window.setTimeout(() => {
      if (sourceDoc) {
        injectWithIconSymbols(container, html, sourceDoc);
      } else {
        container.innerHTML = html;
      }
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          container.style.opacity = "1";
        });
      });
    }, 220);
  }

  async function applyInPlaceAIFilter(bar: HTMLElement, btn: HTMLElement) {
    const container = document.getElementById("post-list-container");
    if (!container || container.dataset.aiFiltered === "true") return;
    const originalPath = bar.getAttribute("data-original-path") || "/original/";
    const originalDoc = await fetchOriginalDoc(originalPath);
    const originalHTML = originalDoc?.getElementById("post-list-container")?.innerHTML;
    if (!originalDoc || !originalHTML) {
      // 抓取失败：回滚状态，保持原列表与按钮视觉一致
      setAIFilterActive(false);
      updateAIFilterButton(btn, false);
      return;
    }
    if (!isAIFilterActive()) return;
    // 每次都基于当前 DOM 备份，Swup 换页后恢复的是当前页列表
    fullListBackupHTML = container.innerHTML;
    container.dataset.aiFiltered = "true";
    swapPostList(container, originalHTML, originalDoc);
    setPaginationHidden(true);
    updateAIFilterButton(btn, true);
  }

  function removeInPlaceAIFilter(btn: HTMLElement) {
    const container = document.getElementById("post-list-container");
    if (container) delete container.dataset.aiFiltered;
    if (container && fullListBackupHTML) {
      swapPostList(container, fullListBackupHTML);
      fullListBackupHTML = null;
    }
    setPaginationHidden(false);
    updateAIFilterButton(btn, false);
  }

  function initAIFilter() {
    const btn = document.getElementById("ai-filter-btn");
    const wrap = document.getElementById("ai-filter-wrap");
    if (!btn || !wrap) return;

    const bar = document.getElementById("category-bar");
    if (!bar) return;

    // 首页和原创文章列表共享这组控制项。
    const { isHome, isOriginal, isArchive } = getCategoryBarState(bar, new URL(window.location.href));

    if (!isHome && !isOriginal && !isArchive) {
      wrap.classList.add("hide-filter");
    } else {
      wrap.classList.remove("hide-filter");
    }

    // 清除旧版 CSS 过滤留下的偏好，改用首页原地过滤。
    localStorage.removeItem("filterAI");
    document.documentElement.classList.remove("filter-ai");
    document.body.classList.remove("filter-ai");

    if (isOriginal) {
      // 直链 /original/ 仍是完整的原创列表视图
      updateAIFilterButton(btn, true);
    } else if (isHome && isAIFilterActive()) {
      // 刷新 / Swup 回到首页时保持过滤态
      applyInPlaceAIFilter(bar, btn);
    } else if (isArchive) {
      updateAIFilterButton(btn, isAIFilterActive());
    } else {
      updateAIFilterButton(btn, false);
    }

    if (btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    btn.addEventListener("click", () => {
      const currentBar = document.getElementById("category-bar");
      const currentBtn = document.getElementById("ai-filter-btn");
      if (!currentBar || !currentBtn) return;
      const currentState = getCategoryBarState(currentBar, new URL(window.location.href));

      // 在 /original/ 直链页上，点击回到首页（保留原直达行为）
      if (currentState.isOriginal) {
        const destination = currentBar.getAttribute("data-home-path") || "/";
        if (window.swup?.navigate) {
          window.swup.navigate(destination, {
            meta: { preserveCategoryScroll: true },
          });
        } else {
          window.location.assign(destination);
        }
        return;
      }

      if (!currentState.isHome && !currentState.isArchive) return;

      const nextActive = !isAIFilterActive();
      setAIFilterActive(nextActive);
      if (currentState.isArchive) {
        updateAIFilterButton(currentBtn, nextActive);
      } else if (nextActive) {
        applyInPlaceAIFilter(currentBar, currentBtn);
      } else {
        removeInPlaceAIFilter(currentBtn);
      }
    });
  }

  // 房子图标与导航栏"主页"tab 行为一致：
  // 首页点击 → 平滑滚动到文章主体（#swup-container）；
  // 其他页面点击 → 写入导航共用的 sessionStorage 标记，到首页后由 Navbar watcher 接管滚动。
  function scrollToMainContent() {
    const target = document.getElementById("swup-container") || document.getElementById("content-wrapper");
    if (!target) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    target.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
  }

  function initHomePillScroll() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.homeScrollBound === "true") return;
    bar.dataset.homeScrollBound = "true";

    bar.addEventListener(
      "click",
      (event) => {
        if (!(event.target instanceof Element)) return;
        const pill = event.target.closest<HTMLAnchorElement>('a.category-pill[data-category-name=""]');
        if (!pill) return;
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const { isHome } = getCategoryBarState(bar, new URL(window.location.href));
        if (isHome) {
          event.preventDefault();
          event.stopPropagation();
          scrollToMainContent();
        } else {
          try {
            sessionStorage.setItem("firefly:nav-scroll-target", "main");
          } catch {
            /* sessionStorage 不可用时静默降级 */
          }
        }
      },
      true,
    );
  }

  initHomePillScroll();
  document.addEventListener("astro:page-load", initHomePillScroll);
  document.addEventListener("swup:contentReplaced", initHomePillScroll);

  initAIFilter();
  document.addEventListener("astro:page-load", initAIFilter);
  document.addEventListener("swup:contentReplaced", initAIFilter);
</script>
