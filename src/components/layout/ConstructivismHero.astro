---
// 构成主义首页 Hero v5 —— 「月亮、星星与构成主义」分层天空
// v5：经典视差模型——滚动时 Hero 各层与正文一起向上，但按深度滞后
// （drift y 为正值 = 向下补偿量，表观速度 = 1 − y；正文 1× 最快，
// 海报文字同为 1×，装饰层 0.5~0.8×，月亮 0.58× 滞后 + 断绳坠落）。
// 月亮单摆阻尼入场（JS 物理模拟）；图层运动全部由 StarField 管理器驱动。
import TypewriterText from "@/components/features/TypewriterText.astro";
import { backgroundWallpaper, siteConfig } from "@/config";

const homeText = backgroundWallpaper.common?.homeText;
const heroTitle = homeText?.title || siteConfig.title;
const heroSubtitle = homeText?.subtitle;
const typewriter = homeText?.typewriter;

const randomSubtitle = Array.isArray(heroSubtitle)
	? heroSubtitle[Math.floor(Math.random() * heroSubtitle.length)]
	: heroSubtitle;

const year = new Date().getFullYear();
const titleChars = [...heroTitle];
---

<section class="ch3-hero" aria-label={siteConfig.title} data-ch3-hero>
	<!-- 首屏加密星空（全局星空之上再叠一层；data-scroll-rate 为视差速率：
	     负值 = 向下补偿（绝对定位层滞后于文档），本层表观 0.6×） -->
	<canvas
		class="starfield ch3-stars"
		data-density="0.0001"
		data-max-stars="180"
		data-meteors="true"
		data-scroll-rate="-0.4"
		aria-hidden="true"></canvas>

	<!-- 透视舞台：鼠标轻微 3D 倾斜的载体
	     drift 语义（v5 视差）：y>0 = 向下补偿量，表观上移速度 = 1−y；
	     值越大越"远"（越滞后）。格式："y 淡出窗口(vh) x" -->
	<div class="ch3-stage" data-ch3-tilt>
		<!-- 远景：主光束（左下 → 右上，穿月而过），最远最慢 0.5× -->
		<div class="ch3-layer ch3-beam" data-ch3-drift="0.5 0.85 0" aria-hidden="true">
			<div class="ch3-beam-core"></div>
			<div class="ch3-beam-edge"></div>
		</div>

		<!-- 第二条细光束：远景 0.55× -->
		<div class="ch3-layer ch3-beam-thin" data-ch3-drift="0.45 0.95 0" aria-hidden="true"></div>

		<!-- 轨道环：天空的坐标系，远景 0.58× -->
		<div class="ch3-layer ch3-orbits" data-ch3-drift="0.42 1.15 0" aria-hidden="true">
			<i class="ch3-orbit ch3-orbit-a"></i>
			<i class="ch3-orbit ch3-orbit-b"></i>
		</div>

		<!-- 刻度尺：左右缘，中景 0.65× -->
		<div class="ch3-layer ch3-ruler ch3-ruler-l" data-ch3-drift="0.35 1.1 0" aria-hidden="true"></div>
		<div class="ch3-layer ch3-ruler ch3-ruler-r" data-ch3-drift="0.35 1.1 0" aria-hidden="true"></div>

		<!-- 准星：月亮左侧的观测标记，中近景 0.7× -->
		<div class="ch3-layer ch3-cross" data-ch3-drift="0.3 0.95 0" aria-hidden="true"></div>

		<!-- 天文坐标标注：准星下方的观测数据，中近景 0.7× -->
		<div class="ch3-layer ch3-coords" data-ch3-drift="0.3 0.95 0" aria-hidden="true">
			<span>RA 05h 35m</span>
			<span>DEC −05° 23′</span>
		</div>

		<!-- 远处星团：左上小星群，远景 0.55× -->
		<div class="ch3-layer ch3-cluster" data-ch3-drift="0.45 1.2 0" aria-hidden="true">
			<i></i><i></i><i></i><i></i><i></i>
		</div>

		<!-- 月亮（深色）/ 日蚀（浅色）：同一位置、同一编舞的主角。
		     入场由 JS 单摆驱动（见 StarField 管理器）。
		     防闪现：inline opacity:0 随 SSR 直出，JS 起摆/编舞时覆写；
		     注意不可用 <noscript><style> 做 no-JS 兜底——Swup 用
		     DOMParser 替换内容时 noscript 会被当作可解析标记，
		     内层 style 泄漏为全局活规则（!important 压过 inline），
		     曾导致跨页回首页后月亮 opacity 永久卡 1。 -->
		<div class="ch3-layer ch3-moon" data-ch3-moon style="opacity: 0" aria-hidden="true">
			<img
				class="ch3-moon-art ch3-moon-for-dark"
				src="/constructivism/moon.webp"
				alt=""
				width="1024"
				height="1024"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<img
				class="ch3-moon-art ch3-moon-for-light"
				src="/constructivism/eclipse.webp"
				alt=""
				width="1024"
				height="1024"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</div>

		<!-- 竖条群：右侧三色立柱，近景 0.8× -->
		<div class="ch3-layer ch3-bars" data-ch3-drift="0.2 0.7 0" aria-hidden="true">
			<i class="ch3-bar ch3-bar-gold"></i>
			<i class="ch3-bar ch3-bar-red"></i>
			<i class="ch3-bar ch3-bar-ink"></i>
		</div>

		<!-- 海报文字层：与正文同速（1×，无补偿），随衔接段先行淡出 -->
		<div class="ch3-layer ch3-text" data-ch3-drift="0 0.42 0">
			<div class="ch3-no">Nº 001 — {year} · Personal Blog</div>
			<div class="ch3-eyebrow">The Moon · The Stars · Constructivism</div>
			<div class="ch3-title" aria-label={heroTitle}>
				{
					titleChars.map((ch, i) => (
						<span class="ch3-char" style={`--i:${i}`} aria-hidden="true">
							{ch === " " ? " " : ch}
						</span>
					))
				}
			</div>
			<div class="ch3-rule" aria-hidden="true"></div>
			{
				heroSubtitle && (
					<div class="ch3-subtitle">
						{typewriter?.enable ? (
							<TypewriterText
								text={heroSubtitle}
								speed={typewriter.speed}
								deleteSpeed={typewriter.deleteSpeed}
								pauseTime={typewriter.pauseTime}
							/>
						) : (
							randomSubtitle
						)}
					</div>
				)
			}
			<div class="ch3-meta-row" aria-hidden="true">
				<span class="ch3-dot"></span>
				<span>Exhibition of Notes</span>
				<span class="ch3-star-sym">✦</span>
			</div>
		</div>

		<!-- 边缘构成元素：右缘竖排 + 左缘俄文竖排，中近景 -->
		<div class="ch3-layer ch3-vertical" data-ch3-drift="0.28 0.9 0" aria-hidden="true">{siteConfig.subtitle}</div>
		<div class="ch3-layer ch3-vertical-l" data-ch3-drift="0.3 1.05 0" aria-hidden="true">Луна · Звёзды · Конструктивизм</div>
		<div class="ch3-layer ch3-swatch" data-ch3-drift="0.25 0.9 0" aria-hidden="true"><i></i><i></i><i></i></div>
	</div>

	<!-- 地平线：月亮沉没处——一条横贯的金色细线 + 极轻光晕 -->
	<div class="ch3-horizon" aria-hidden="true">
		<span class="ch3-horizon-glow"></span>
		<span class="ch3-horizon-line"></span>
	</div>

	<!-- 向下滚动提示 -->
	<a class="ch3-scrollcue" href="#swup-container" aria-label="Scroll to content">
		<span class="ch3-scrollcue-text">Scroll</span>
		<span class="ch3-scrollcue-line"></span>
	</a>
</section>
